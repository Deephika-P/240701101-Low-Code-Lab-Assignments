		workflow
		{
		form
		{
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Event_Registration_Form
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.loginuserid"
							subject : "Event Registration : New entry added"
							message : "<div>Hello,<br><br>A new entry added in 'Event_Registration_Form' form of Event Registration application.<br></div>"
						)
					}
				}
			}
			On_Registration_Submit_Wo as "On_Registration_Submit_Workflow"
			{
				type =  form
				form = Event_Registration_Form

				record event = on add or edit

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "deephika.p.2024.cse@rajalakshmi.edu.in"
							subject : "Event Registration"
							message : "<div>The Registration is Completed Successfully!<br></div>"
							attachments : template : _default as inline
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Payment_Reminder_Sc as "Daily_Payment_Reminder_Schedule"
			{
				type =  schedule
					status = inactive
				start = "2026-08-21 15:55:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "deephika.p.2024.cse@rajalakshmi.edu.in"
							subject : "Event Registration"
							message : "<div>Successfully Register for the Event!</div>"
							attachments : view : Registrations_Spreadsheet as PDF
						)
					}
				}
			}
		}

		approval
		{
			VIP_Sponsorship_Pass_Appr as "VIP_Sponsorship_Pass_Approval"
			{
				type =  approval
				form = Event_Registration_Form[Academic_CGPA == 8.5]
				display fields = [Email1,Participant_Name,Participant_Type,Team_Size,Contact_Number,College_Organization_Name,Institution_Address]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : "deephika.p.2024.cse@rajalakshmi.edu.in"
								subject : "Approval Request"
								message : "<div>Your request has been approved.<br></div>"
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : "deephika.p.2024.cse@rajalakshmi.edu.in"
								subject : "Reject Request"
								message : "<div>${ID}Your request has been rejected.<br></div>"
							)
						}
					}
				}
			}
		}

