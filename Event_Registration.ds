 application "Event Registration"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Colleges
		{
			success message = "College Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			College_Name
			(
    			type = text
				displayname = "College Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			College_Code
			(
    			type = text
				displayname = "College Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Event_Registration_Form
		{
			displayname = "Event Registration Form"
			success message = "Event Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Participant_Details
			(
				type = section
				displayname = "Participant Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Participant_Name
			(
    			type = name
				displayname = "Participant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Participant_Type
			(
				type = radiobuttons
				displayname = "Participant Type"
				maxchar = 100
				values = {"Student","Faculty","Professional"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Team_Size
			(
				type = number
				displayname = "Team Size"
				maxchar = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Contact_Institution_Details
			(
				type = section
				displayname = "Contact & Institution Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Email1
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
    			allowedcountries={in}
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			College_Organization_Name
			(
    			type = text
				displayname = "College  Organization Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Institution_Address
			(
    			type = address
				displayname = "Institution Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Event_Preferences
			(
				type = section
				displayname = "Event Preferences"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Event_Track
			(
				type = picklist
				displayname = "Event Track"
				maxchar = 100
				values = {"AI & Data Science Track","Web Development Track","Cloud Computing Track","Cyber Security  Track","IoT & Embedded System Track","Blockchain Track"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Areas_Of_Interest
			(
				type = list	
				displayname = "Areas Of Interest"
				values = {"Artificial Intelligence","Generative AI","Data Science","Web Development","Cloud Computing","Cyber Security","IoT & Embedded Systems","Blockchain"}
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Expectations_Form_Event
			(
    			type = textarea
				displayname = "Expectations Form Event"
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Scheduling
			(
				type = section
				displayname = "Scheduling & Acknowlegement"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Preferred_Session_Date
			(
    			type = date
				displayname = "Preferred Session Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Preferred_Session_Slot
			(
    			type = time
				displayname = "Preferred Session Slot"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 5
	 			column = 1   
				width = medium
			)
			must have Agree_To_Code_Of_Conduct
			(
				type = checkboxes	
				displayname = "Agree To Code Of Conduct"
				values = {"I agree to the Event Code of Conduct"}
	 			row = 5
	 			column = 1   
				width = medium
			)
			Identity_Verification
			(
				type = section
				displayname = "Identity & Verification"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Colleges
			(
				type = picklist	
				values  = Colleges.ID
    			displayformat = [College_Name]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Profile_Photo
			(
    			type = image
				displayname = "Profile Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 6
	 			column = 1   
				width = medium
			)
			ID_Proof_Upload
			(
    			type = upload file
				displayname = "ID Proof Upload"
				browse = local_drive
				allowed file formats = {"pdf","jpg","png"}
	 			row = 6
	 			column = 1   
				width = medium
			)
			Academic_CGPA
			(
				type = decimal
				displayname = "Academic CGPA"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Team_Members_Details
			(
				type = grid
				displayname = "Team Members Details"
				Name
				(
    				type = name
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
				Email
				(
    				type = email
					maxchar = 80
					width = medium
					personal data = true
				)
				Role
				(
    				type = text
					width = medium
				)
	 			row = 7
	 			column = 1   
				width = medium
			)
			Team_Media_Details
			(
				type = section
				displayname = "Team & Media Details"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			Portfolio_LinkedIn_U
			(
    			type = url
				displayname = "Portfolio LinkedIn URL"
				enable  linkname
	 			row = 8
	 			column = 1   
				width = medium
			)
			Team_Intro_Video
			(
    			type = video
				displayname = "Team Intro Video"
    			duration=60
	 			row = 8
	 			column = 1   
				width = medium
			)
			Special_Requirement_Voice_Note
			(
     			type = audio
				displayname = "Special Requirement Voice Note"
    			duration=60
	 			row = 8
	 			column = 1   
				width = medium
			)
			Fee_Accommodation
			(
				type = section
				displayname = "Fee & Accommodation"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			must have Event_Guidelines_Display
			(
    			type = checkbox
				displayname = "Requires Accommodation"
				initial value = false
	 			row = 9
	 			column = 1   
				width = medium
			)
			Registration_Fee_Paid
			(
				displayname = "Registration Fee Paid"
				type = INR
				format = commadotindian
	 			row = 9
	 			column = 1   
				width = medium
			)
			Early_Bird_Discount_Percent
			(
    			type = percentage
				displayname = "Early Bird Discount Percent"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Total_Amount_Payable
			(
				type = decimal
				displayname = "Total Amount Payable"
	 			row = 9
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Registration_Fee_Paid - input.Registration_Fee_Paid * input.Early_Bird_Discount_Percent
    						visibility = true
    			)
			)
			Declaration_System_Generated_Values
			(
				type = section
				displayname = "Declaration & System-Generated Values"
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Event_Guidelines_Display1
			(
    			type = richtext
				displayname = "Event Guidelines Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 10
	 			column = 1   
				width = medium
			)
			must have Participant_Digital_Signature
			(
    			type = signature
				displayname = "Participant Digital Signature"
	 			row = 10
	 			column = 1   
				width = medium
				personal data = true
			)
			Registration_Submitted_On
			(
    			type = datetime
				displayname = "Registration Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 10
	 			column = 1   
				width = medium
			)
			Registration_ID
			(
    			type = autonumber
				displayname = "Registration ID"
				start index = 1
	 			row = 10
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Event Entry QR Code"
				value = "${Participant_Name}"
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Registration Submitted","Verification","Stage3"}
			}
		}
		form Test
		{
			success message = "Test Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Date_field
			(
    			type = date
				displayname = "Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 1,2,3,4,5
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Event_Registrations
		{
			displayName = "All Event Registrations"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Institution_Address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Email1 as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				College_Organization_Name as "College  Organization Name"
				Expectations_Form_Event as "Expectations Form Event"
				Team_Size as "Team Size"
				Preferred_Session_Date as "Preferred Session Date"
				Preferred_Session_Slot as "Preferred Session Slot"
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Areas_Of_Interest as "Areas Of Interest"
				Agree_To_Code_Of_Conduct as "Agree To Code Of Conduct"
				Event_Guidelines_Display1 as "Event Guidelines Display"
				Event_Guidelines_Display as "Requires Accommodation"
				Portfolio_LinkedIn_U as "Portfolio LinkedIn URL"
				Profile_Photo as "Profile Photo"
				Early_Bird_Discount_Percent as "Early Bird Discount Percent"
				Registration_Fee_Paid as "Registration Fee Paid"
				Academic_CGPA as "Academic CGPA"
				Registration_Submitted_On as "Registration Submitted On"
				Team_Members_Details.Name as "Team Members Details"
				Colleges
				Participant_Digital_Signature as "Participant Digital Signature"
				ID_Proof_Upload as "ID Proof Upload"
				Special_Requirement_Voice_Note as "Special Requirement Voice Note"
				Team_Intro_Video as "Team Intro Video"
				Registration_ID as "Registration ID"
				Total_Amount_Payable as "Total Amount Payable"
				QR_Code as "Event Entry QR Code"
			)
		}
		default list All_Colleges
		{
			displayName = "All Colleges"
			show all rows from Colleges    
			(
				College_Name as "College Name"
				College_Code as "College Code"
			)
		}
		list All_Registrations_List
		{
			displayName = "All Registrations List"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Participant_Type as "Participant Type"
				Team_Size as "Team Size"
				Email1 as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				College_Organization_Name as "College  Organization Name"
				Institution_Address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Event_Track as "Event Track"
				Areas_Of_Interest as "Areas Of Interest"
				Expectations_Form_Event as "Expectations Form Event"
				Preferred_Session_Date as "Preferred Session Date"
				Preferred_Session_Slot as "Preferred Session Slot"
				Agree_To_Code_Of_Conduct as "Agree To Code Of Conduct"
				Colleges
				Profile_Photo as "Profile Photo"
				ID_Proof_Upload as "ID Proof Upload"
				Academic_CGPA as "Academic CGPA"
				Portfolio_LinkedIn_U as "Portfolio LinkedIn URL"
				Team_Intro_Video as "Team Intro Video"
				Special_Requirement_Voice_Note as "Special Requirement Voice Note"
				Event_Guidelines_Display as "Requires Accommodation"
				Registration_Fee_Paid as "Registration Fee Paid"
				Early_Bird_Discount_Percent as "Early Bird Discount Percent"
				Total_Amount_Payable as "Total Amount Payable"
				Event_Guidelines_Display1 as "Event Guidelines Display"
				Participant_Digital_Signature as "Participant Digital Signature"
				Registration_Submitted_On as "Registration Submitted On"
				Registration_ID as "Registration ID"
				QR_Code as "Event Entry QR Code"
			)
		}
		spreadsheet Registrations_Spreadsheet
		{
			displayName = "Registrations_Spreadsheet"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Participant_Type as "Participant Type"
				Team_Size as "Team Size"
				Email1 as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				College_Organization_Name as "College  Organization Name"
				Institution_Address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Event_Track as "Event Track"
				Areas_Of_Interest as "Areas Of Interest"
				Expectations_Form_Event as "Expectations Form Event"
				Preferred_Session_Date as "Preferred Session Date"
				Preferred_Session_Slot as "Preferred Session Slot"
				Agree_To_Code_Of_Conduct as "Agree To Code Of Conduct"
				Colleges
				Profile_Photo as "Profile Photo"
				ID_Proof_Upload as "ID Proof Upload"
				Academic_CGPA as "Academic CGPA"
				Portfolio_LinkedIn_U as "Portfolio LinkedIn URL"
				Team_Intro_Video as "Team Intro Video"
				Special_Requirement_Voice_Note as "Special Requirement Voice Note"
				Event_Guidelines_Display as "Requires Accommodation"
				Registration_Fee_Paid as "Registration Fee Paid"
				Early_Bird_Discount_Percent as "Early Bird Discount Percent"
				Total_Amount_Payable as "Total Amount Payable"
				Event_Guidelines_Display1 as "Event Guidelines Display"
				Participant_Digital_Signature as "Participant Digital Signature"
				Registration_Submitted_On as "Registration Submitted On"
				Registration_ID as "Registration ID"
				QR_Code as "Event Entry QR Code"
			)
		}
		kanban Registration_Status_Kanban
		{
			displayName = "Registration_Status_Kanban"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Participant_Type as "Participant Type"
				Team_Size as "Team Size"
				Email1 as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				College_Organization_Name as "College  Organization Name"
				Institution_Address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Event_Track as "Event Track"
				Areas_Of_Interest as "Areas Of Interest"
				Expectations_Form_Event as "Expectations Form Event"
				Preferred_Session_Date as "Preferred Session Date"
				Preferred_Session_Slot as "Preferred Session Slot"
				Agree_To_Code_Of_Conduct as "Agree To Code Of Conduct"
				Colleges
				Profile_Photo as "Profile Photo"
				ID_Proof_Upload as "ID Proof Upload"
				Academic_CGPA as "Academic CGPA"
				Portfolio_LinkedIn_U as "Portfolio LinkedIn URL"
				Team_Intro_Video as "Team Intro Video"
				Special_Requirement_Voice_Note as "Special Requirement Voice Note"
				Event_Guidelines_Display as "Requires Accommodation"
				Registration_Fee_Paid as "Registration Fee Paid"
				Early_Bird_Discount_Percent as "Early Bird Discount Percent"
				Total_Amount_Payable as "Total Amount Payable"
				Event_Guidelines_Display1 as "Event Guidelines Display"
				Participant_Digital_Signature as "Participant Digital Signature"
				Registration_Submitted_On as "Registration Submitted On"
				Registration_ID as "Registration ID"
				QR_Code as "Event Entry QR Code"
			)
			options
			(
	 			display field = Event_Track
	 		)
		}
		default list All_Tests
		{
			displayName = "All Tests"
			show all rows from Test    
			(
				Date_field as "Date"
			)
		}
	}
	pages
	{
		page Event_Command_Center_Page
		{
			displayname = "Event_Command_Center_Page"
